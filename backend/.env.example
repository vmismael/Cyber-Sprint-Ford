# Ford Intelligence API — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env (ele está no .gitignore).
# Na Vercel: Settings > Environment Variables, com valores diferentes por ambiente.

NODE_ENV=development

# openssl rand -base64 48
JWT_SECRET=
# Vida do access token em segundos (padrão 900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# openssl rand -base64 32  (cifra endereço de coleta e observações no banco)
DATA_ENCRYPTION_KEY=

# openssl rand -hex 16  (sal do hash de IP nos logs)
LOG_IP_SALT=

# Supabase > Connect > Transaction pooler (porta 6543)
# Sem DATABASE_URL a API usa armazenamento em memória (apenas desenvolvimento).
DATABASE_URL=

# Origens web autorizadas (CORS), separadas por vírgula. O app nativo não precisa.
ALLOWED_ORIGINS=http://localhost:8081

# Swagger em /docs. Padrão: ligado fora de produção.
DOCS_ENABLED=true

# Usado apenas por `npm run db:seed` (senhas com 12+ caracteres)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ANALYST_EMAIL=
SEED_ANALYST_PASSWORD=
