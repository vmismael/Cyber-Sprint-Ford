{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Caminho explícito: o build da Vercel (TypeScript 7) não acha @types/node sem ele (TS2688).
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src", "tests", "scripts"]
}
