{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext exige extensão nos imports relativos (./app.js). Na Vercel cada arquivo
    // roda como ESM sem bundler, e "./app" sem extensão derruba a função (ERR_MODULE_NOT_FOUND).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // Caminho explícito: o build da Vercel (TypeScript 7) não acha @types/node sem ele (TS2688).
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src", "tests", "scripts"]
}
